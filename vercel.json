{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/parent/(.*)", "destination": "/parent/index.html" },
    { "source": "/waste/(.*)", "destination": "/waste/index.html" },
    { "source": "/extracurricular/(.*)", "destination": "/extracurricular/index.html" },
    { "source": "/library/(.*)", "destination": "/library/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
