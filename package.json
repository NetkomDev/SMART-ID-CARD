{
  "name": "aksis-platform",
  "private": true,
  "version": "0.3.0",
  "description": "AKSIS multi-school platform",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "dev:admin": "vite --config apps/admin-web/vite.config.ts",
    "dev:parent": "vite --config apps/parent-pwa/vite.config.ts",
    "dev:waste": "vite --config apps/waste-pwa/vite.config.ts",
    "dev:extracurricular": "vite --config apps/extracurricular-pwa/vite.config.ts",
    "dev:library": "vite --config apps/library-terminal/vite.config.ts",
    "dev:led": "vite --config apps/led-gateway/vite.config.ts",
    "dev:command": "vite --config apps/command-center/vite.config.ts",
    "dev:card-writer": "vite --config apps/card-writer/vite.config.ts",
    "dev:operations": "vite --config apps/operations-console/vite.config.ts",
    "build": "tsc -p apps/api/tsconfig.json",
    "vercel-build": "npm run build:admin && npm run build:parent && npm run build:waste && npm run build:extracurricular && npm run build:library && mkdir -p dist && cp -r apps/admin-web/dist/* dist/ && mkdir -p dist/parent && cp -r apps/parent-pwa/dist/* dist/parent/ && mkdir -p dist/waste && cp -r apps/waste-pwa/dist/* dist/waste/ && mkdir -p dist/extracurricular && cp -r apps/extracurricular-pwa/dist/* dist/extracurricular/ && mkdir -p dist/library && cp -r apps/library-terminal/dist/* dist/library/",
    "build:admin": "vite build --config apps/admin-web/vite.config.ts",
    "build:parent": "vite build --config apps/parent-pwa/vite.config.ts",
    "build:waste": "vite build --config apps/waste-pwa/vite.config.ts",
    "build:extracurricular": "vite build --config apps/extracurricular-pwa/vite.config.ts",
    "build:library": "vite build --config apps/library-terminal/vite.config.ts",
    "build:led": "vite build --config apps/led-gateway/vite.config.ts",
    "build:command": "vite build --config apps/command-center/vite.config.ts",
    "build:card-writer": "vite build --config apps/card-writer/vite.config.ts",
    "build:operations": "vite build --config apps/operations-console/vite.config.ts",
    "start": "node apps/api/dist/server.js",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db:library": "bash tooling/test-phase-11-library.sh",
    "test:watch": "vitest",
    "typecheck:portals": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/admin-web/tsconfig.json --noEmit && tsc -p apps/parent-pwa/tsconfig.json --noEmit && tsc -p apps/waste-pwa/tsconfig.json --noEmit && tsc -p apps/extracurricular-pwa/tsconfig.json --noEmit && tsc -p apps/library-terminal/tsconfig.json --noEmit",
    "test:db:portals": "bash tooling/test-portal-qr.sh",
    "test:db:super-admin": "bash tooling/test-super-admin-db.sh",
    "test:browser:super-admin": "node tooling/test-super-admin-browser.mjs",
    "test:browser:pwa": "node tooling/test-pwa-ui.mjs",
    "test:browser:waste": "node tooling/test-waste-pwa.mjs",
    "test:db:waste": "bash tooling/test-waste-db.sh",
    "test:browser:parent": "node tooling/test-parent-pwa.mjs",
    "test:db:parent:local": "bash tooling/test-parent-db-local.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@types/compression": "^1.8.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "html5-qrcode": "^2.3.8",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
