NODE_ENV=development
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
CORS_ORIGINS=http://localhost:4173,http://localhost:4174,http://localhost:4175,http://localhost:4176,http://localhost:4177
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Backend only: required for creating QR portal Auth identities. Never use VITE_ for this key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional full portal URLs printed into admin QR codes (HTTPS for smartphone installation).
# Development defaults: parent :4174, waste :4175, extracurricular :4176, library :4177.
# VITE_PARENT_URL=https://www.aksis.co.id/parent/
# VITE_WASTE_URL=https://www.aksis.co.id/waste/
# VITE_EXTRACURRICULAR_URL=https://www.aksis.co.id/extracurricular/
# VITE_LIBRARY_URL=https://www.aksis.co.id/library/

# Browser sessions: independent random secret of at least 32 characters, server only.
SESSION_COOKIE_KEY=replace-with-at-least-32-random-characters
PUBLIC_APP_URL=http://localhost:4173
# Production requires database. Apply runtime-limit migration before switching.
RATE_LIMIT_BACKEND=memory
# Explicit trusted proxy CIDRs only; leave empty when no trusted reverse proxy.
TRUST_PROXY_CIDRS=
